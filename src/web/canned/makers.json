   "comchatx": {
    "card": {
     "name": "GPT",
     "vendor": "OpenAI",
     "description": {
      "en": "GPT is OpenAI's model family. GPT-6 Sol is designed for reasoning over long documents and tables, while GPT-6 Luna prioritises speed and lower cost. Both can read images and files.\n\nChoose Sol for long reports and multi-step instructions. Choose Luna for everyday questions and summaries.",
      "zh": "GPT 是 OpenAI 的模型系列。GPT-6 Sol 适合分析长文档和表格；GPT-6 Luna 响应更快、价格更低。两者都能读取图片和文件。\n\n长报告和多步骤任务可选 Sol；日常提问和摘要可选 Luna。"
     }
    },
    "mark": {
     "logo": "openai"
    },
    "aliases": [
     "ChatGPT"
    ],
    "plans": [
     "ChatGPT"
    ],
    "signIn": {
     "steps": [
      { "kind": "link" },
      { "kind": "address", "words": { "en": "After you sign in, the browser stops on a page that won't open. That means the sign-in worked.", "zh": "登录后，浏览器会停在一个无法打开的页面，这表示登录已成功。" } },
      { "kind": "field", "words": { "en": "Copy the whole address from the address bar, then come back and paste it here.", "zh": "复制地址栏里的完整网址，回到这里粘贴。" } }
     ]
    }
   }
  },
