   "name": "@comchatx/openai",
   "description": "Brings OpenAI's models to cx.",
   "kinds": [
    "extension"
   ],
   "author": "ComChatX",
   "updated": "2026-11-04T09:12:00.000Z",
   "version": "0.1.0",
